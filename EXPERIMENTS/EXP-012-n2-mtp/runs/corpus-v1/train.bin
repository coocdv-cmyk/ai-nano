<SPEC>
The handlers factory must bind the loop variable into each closure; today every closure sees the final value.
<TEST>
# tests/test_service.py
from handlers import make_handlers


def test_each_closure_binds_its_own_name():
    handlers = make_handlers('x', ['a', 'b', 'c'])
    assert [h(1) for h in handlers] == ['x:a:1', 'x:b:1', 'x:c:1']
<FAIL>
pytest: 1 failed before repair; 3 verifier call(s); 0 failed after repair
candidate: closure_binding -> 
@@ -1,5 +1,5 @@
-        handlers.append(lambda value: f'{prefix}:{name}:{value}')
+        handlers.append(lambda value, *, name=name: f'{prefix}:{name}:{value}')
<SOL>
# handlers.py
def make_handlers(prefix, names):
    handlers = []
    for name in names:
        handlers.append(lambda value, *, name=name: f'{prefix}:{name}:{value}')
    return handlers
</SOL>

