<SPEC>
The tray accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from tray import sample_at


def test_valid_positions():
    assert sample_at([51, 52, 53], 0) == 51
    assert sample_at([51, 52, 53], 2) == 53


def test_negative_rejected():
    with pytest.raises(IndexError):
        sample_at([51, 52, 53], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        sample_at([51, 52, 53], 3)
<FAIL>
