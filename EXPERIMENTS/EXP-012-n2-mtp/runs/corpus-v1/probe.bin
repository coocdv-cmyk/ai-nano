+    if where < 0:
+        raise IndexError('where must be >= 0')
+    if where <= len(samples):
<SOL>
# tray.py
def sample_at(samples, where):
    if where < 0:
        raise IndexError('where must be >= 0')
    if where <= len(samples):
        return samples[where]
    return None
</SOL>

