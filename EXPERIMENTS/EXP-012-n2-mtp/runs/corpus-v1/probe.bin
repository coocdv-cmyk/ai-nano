from decorators import make_decorators


def test_each_closure_binds_its_own_name():
    handlers = make_decorators('dec', ['one', 'two', 'three'])
    assert [h(1) for h in handlers] == ['dec:one:1', 'dec:two:1', 'dec:three:1']
