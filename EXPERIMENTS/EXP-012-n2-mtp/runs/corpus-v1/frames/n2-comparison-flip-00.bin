<SPEC>
The access gate must allow only values strictly below required; equality is not enough and the current comparison admits it.
<TEST>
# tests/test_service.py
from access import can_access


def test_equal_is_denied():
    assert can_access(2, 2) is False


def test_lower_is_allowed():
    assert can_access(1, 2) is True


def test_higher_is_denied():
    assert can_access(3, 2) is False
