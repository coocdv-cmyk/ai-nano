<SPEC>
The kitchen service appends a order to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from kitchen import add_order


def test_each_call_gets_its_own_tickets():
    first = add_order('soup')
    second = add_order('bread')
    assert first == ['soup']
    assert second == ['bread']
    assert first is not second
