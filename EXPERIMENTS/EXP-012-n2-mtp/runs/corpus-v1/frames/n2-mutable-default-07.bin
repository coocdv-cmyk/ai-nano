<SPEC>
The studio service appends a take to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from studio import schedule_take


def test_each_call_gets_its_own_takes():
    first = schedule_take('intro')
    second = schedule_take('outro')
    assert first == ['intro']
    assert second == ['outro']
    assert first is not second
