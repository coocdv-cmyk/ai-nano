<SPEC>
The aviary service appends a bird to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from aviary import tag_bird


def test_each_call_gets_its_own_tags():
    first = tag_bird('finch')
    second = tag_bird('robin')
    assert first == ['finch']
    assert second == ['robin']
    assert first is not second
