<SPEC>
The track accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from track import clip_at


def test_valid_positions():
    assert clip_at([11, 12, 13], 0) == 11
    assert clip_at([11, 12, 13], 2) == 13


def test_negative_rejected():
    with pytest.raises(IndexError):
        clip_at([11, 12, 13], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        clip_at([11, 12, 13], 3)
