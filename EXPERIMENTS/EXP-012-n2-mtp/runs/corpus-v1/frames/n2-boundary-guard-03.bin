<SPEC>
The window accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from window import show_at


def test_valid_positions():
    assert show_at([2, 4, 6], 0) == 2
    assert show_at([2, 4, 6], 2) == 6


def test_negative_rejected():
    with pytest.raises(IndexError):
        show_at([2, 4, 6], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        show_at([2, 4, 6], 3)
