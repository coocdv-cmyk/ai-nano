<SPEC>
The slots accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from slots import entry_at


def test_valid_positions():
    assert entry_at([31, 32, 33], 0) == 31
    assert entry_at([31, 32, 33], 2) == 33


def test_negative_rejected():
    with pytest.raises(IndexError):
        entry_at([31, 32, 33], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        entry_at([31, 32, 33], 3)
