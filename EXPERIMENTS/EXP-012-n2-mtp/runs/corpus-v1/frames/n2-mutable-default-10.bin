<SPEC>
The atelier service appends a swatch to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from atelier import pin_swatch


def test_each_call_gets_its_own_swatches():
    first = pin_swatch('linen')
    second = pin_swatch('wool')
    assert first == ['linen']
    assert second == ['wool']
    assert first is not second
