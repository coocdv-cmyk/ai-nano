<SPEC>
The library service appends a book to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from library import checkout_book


def test_each_call_gets_its_own_loans():
    first = checkout_book('dune')
    second = checkout_book('emma')
    assert first == ['dune']
    assert second == ['emma']
    assert first is not second
