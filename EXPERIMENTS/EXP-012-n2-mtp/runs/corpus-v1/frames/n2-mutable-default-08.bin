<SPEC>
The harbor service appends a vessel to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from harbor import dock_vessel


def test_each_call_gets_its_own_berths():
    first = dock_vessel('tug')
    second = dock_vessel('ferry')
    assert first == ['tug']
    assert second == ['ferry']
    assert first is not second
