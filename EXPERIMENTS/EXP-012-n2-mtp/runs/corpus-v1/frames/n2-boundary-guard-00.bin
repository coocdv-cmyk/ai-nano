<SPEC>
The racks accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from racks import peek


def test_valid_positions():
    assert peek([10, 20, 30], 0) == 10
    assert peek([10, 20, 30], 2) == 30


def test_negative_rejected():
    with pytest.raises(IndexError):
        peek([10, 20, 30], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        peek([10, 20, 30], 3)
