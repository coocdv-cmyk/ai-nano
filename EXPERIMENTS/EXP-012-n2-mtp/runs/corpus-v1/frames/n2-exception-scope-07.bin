<SPEC>
The studio helper may convert a policy failure into -1, but a programming error such as TypeError must never be swallowed.
<TEST>
# tests/test_service.py
import pytest
from errors import PolicyError
from studio import schedule_take


def test_policy_error_falls_back():
    def handler(value):
        raise PolicyError('blocked')
    assert schedule_take(handler, 1) == -1


def test_type_error_propagates():
    def handler(value):
        raise TypeError('bad')
    with pytest.raises(TypeError):
        schedule_take(handler, 1)
