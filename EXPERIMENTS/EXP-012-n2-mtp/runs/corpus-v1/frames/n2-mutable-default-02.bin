<SPEC>
The inbox service appends a message to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from inbox import queue_message


def test_each_call_gets_its_own_pending():
    first = queue_message('hello')
    second = queue_message('goodbye')
    assert first == ['hello']
    assert second == ['goodbye']
    assert first is not second
