<SPEC>
The garden service appends a seed to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from garden import plant_seed


def test_each_call_gets_its_own_bed():
    first = plant_seed('tulip')
    second = plant_seed('rose')
    assert first == ['tulip']
    assert second == ['rose']
    assert first is not second
