<SPEC>
The locks gate must allow only values strictly below limit; equality is not enough and the current comparison admits it.
<TEST>
# tests/test_service.py
from locks import unlocks_with


def test_equal_is_denied():
    assert unlocks_with(5, 5) is False


def test_lower_is_allowed():
    assert unlocks_with(4, 5) is True


def test_higher_is_denied():
    assert unlocks_with(6, 5) is False
