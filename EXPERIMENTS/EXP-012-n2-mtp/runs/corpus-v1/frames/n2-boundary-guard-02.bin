<SPEC>
The buffer accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from buffer import read_at


def test_valid_positions():
    assert read_at([5, 6, 7], 0) == 5
    assert read_at([5, 6, 7], 2) == 7


def test_negative_rejected():
    with pytest.raises(IndexError):
        read_at([5, 6, 7], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        read_at([5, 6, 7], 3)
