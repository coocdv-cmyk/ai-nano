<SPEC>
The grid accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from grid import cell_at


def test_valid_positions():
    assert cell_at([41, 42, 43], 0) == 41
    assert cell_at([41, 42, 43], 2) == 43


def test_negative_rejected():
    with pytest.raises(IndexError):
        cell_at([41, 42, 43], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        cell_at([41, 42, 43], 3)
