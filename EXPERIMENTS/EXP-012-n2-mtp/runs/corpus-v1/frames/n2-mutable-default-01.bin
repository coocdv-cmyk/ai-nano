<SPEC>
The roster service appends a member to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from roster import append_member


def test_each_call_gets_its_own_members():
    first = append_member('alice')
    second = append_member('bob')
    assert first == ['alice']
    assert second == ['bob']
    assert first is not second
