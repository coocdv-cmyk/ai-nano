<SPEC>
The stack accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from stack import top_at


def test_valid_positions():
    assert top_at([4, 8, 16], 0) == 4
    assert top_at([4, 8, 16], 2) == 16


def test_negative_rejected():
    with pytest.raises(IndexError):
        top_at([4, 8, 16], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        top_at([4, 8, 16], 3)
