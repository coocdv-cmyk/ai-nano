<SPEC>
The orchard service appends a crate to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from orchard import pack_crate


def test_each_call_gets_its_own_crates():
    first = pack_crate('plum')
    second = pack_crate('fig')
    assert first == ['plum']
    assert second == ['fig']
    assert first is not second
