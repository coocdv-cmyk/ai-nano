<SPEC>
The pages accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from pages import line_at


def test_valid_positions():
    assert line_at([21, 22, 23], 0) == 21
    assert line_at([21, 22, 23], 2) == 23


def test_negative_rejected():
    with pytest.raises(IndexError):
        line_at([21, 22, 23], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        line_at([21, 22, 23], 3)
