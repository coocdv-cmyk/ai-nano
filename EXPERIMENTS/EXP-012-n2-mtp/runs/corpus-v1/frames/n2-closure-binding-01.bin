# tests/test_service.py
from routes import make_routes


def test_each_closure_binds_its_own_name():
    handlers = make_routes('api', ['v1', 'v2', 'v3'])
    assert [h(1) for h in handlers] == ['api:v1:1', 'api:v2:1', 'api:v3:1']
