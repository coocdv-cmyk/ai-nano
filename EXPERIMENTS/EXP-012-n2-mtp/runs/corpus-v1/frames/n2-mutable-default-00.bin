<SPEC>
The ledger service appends a entry to a collection. Each call must start from an empty collection; the current default is shared between calls.
<TEST>
# tests/test_service.py
from ledger import record_entry


def test_each_call_gets_its_own_journal():
    first = record_entry('open')
    second = record_entry('close')
    assert first == ['open']
    assert second == ['close']
    assert first is not second
