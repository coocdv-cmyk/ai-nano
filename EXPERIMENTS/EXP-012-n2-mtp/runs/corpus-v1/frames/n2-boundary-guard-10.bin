<SPEC>
The lanes accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from lanes import runner_at


def test_valid_positions():
    assert runner_at([71, 72, 73], 0) == 71
    assert runner_at([71, 72, 73], 2) == 73


def test_negative_rejected():
    with pytest.raises(IndexError):
        runner_at([71, 72, 73], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        runner_at([71, 72, 73], 3)
