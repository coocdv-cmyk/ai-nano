<SPEC>
The shelves accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from shelves import book_at


def test_valid_positions():
    assert book_at([81, 82, 83], 0) == 81
    assert book_at([81, 82, 83], 2) == 83


def test_negative_rejected():
    with pytest.raises(IndexError):
        book_at([81, 82, 83], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        book_at([81, 82, 83], 3)
