<SPEC>
The bins accessor accepts only positions 0..2 and must raise IndexError for negative or overflowing positions instead of returning a silent None.
<TEST>
# tests/test_service.py
import pytest
from bins import bucket_at


def test_valid_positions():
    assert bucket_at([61, 62, 63], 0) == 61
    assert bucket_at([61, 62, 63], 2) == 63


def test_negative_rejected():
    with pytest.raises(IndexError):
        bucket_at([61, 62, 63], -1)


def test_overflow_rejected():
    with pytest.raises(IndexError):
        bucket_at([61, 62, 63], 3)
